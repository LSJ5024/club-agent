# Copy this into Streamlit Community Cloud: App settings -> Secrets
# (or copy to .streamlit/secrets.toml locally to test the cloud path — that
# file is gitignored and never committed, same as .env)

API_KEY = "your_groq_key_here"
BASE_URL = "https://api.groq.com/openai/v1"
MODEL = "openai/gpt-oss-120b"
MAX_TOOL_ROUNDS = "5"
MAX_HISTORY_MESSAGES = "20"
