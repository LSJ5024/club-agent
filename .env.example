# Choose ONE provider (both are OpenAI-compatible)

# --- Groq ---
API_KEY=your_groq_key_here
BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b
# openai/gpt-oss-20b also works but hallucinated facility names and skipped
# confirmations in testing. Use the 120b model for the live demo.

# --- xAI (Grok) ---
# API_KEY=your_xai_key_here
# BASE_URL=https://api.x.ai/v1
# MODEL=grok-3-mini

# Agent settings
MAX_TOOL_ROUNDS=5
MAX_HISTORY_MESSAGES=20
